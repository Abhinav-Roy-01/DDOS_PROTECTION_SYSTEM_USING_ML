# DNS Shield — environment variables
APP_ENV=development
SECRET_KEY=change-me-in-production

DNS_UDP_PORT=53
DNS_UPSTREAM_PRIMARY=8.8.8.8
DNS_UPSTREAM_SECONDARY=1.1.1.1
DNS_CACHE_TTL=300

DOH_PORT=443
DOTLS_PORT=853
TLS_CERT_PATH=./INFRA/NGINX/certs/cert.pem
TLS_KEY_PATH=./INFRA/NGINX/certs/key.pem

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=dnsshield
DB_USER=dnsadmin
DB_PASSWORD=change-me

MODEL_PATH=./ML/MODELS/dns_model.pkl
RETRAIN_INTERVAL_HOURS=24
ANOMALY_THRESHOLD=0.72

ABUSEIPDB_KEY=
OTXKEY=
TAXII_SERVER_URL=
TAXII_COLLECTION=

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# HTTP-LAYER-SHIELD (legacy behavioral bot shield, merged layer)
CAPTCHA_SECRET_KEY=ddos-captcha-secret-key-change-in-production
PARTIAL_TOKEN_SECRET=partial-token-secret-key-change-in-production
FULL_TOKEN_SECRET=full-token-secret-key-change-in-production
HTTP_SHIELD_PORT=8080
